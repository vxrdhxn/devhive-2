# DevHive environment variables (the whole app runs on Vercel as one Next.js project)
# Locally: put these in frontend/.env.local (`npm run env:sync` copies them from the
# repo-root .env that `neon env pull` writes). On Vercel: Project → Settings → Environment Variables.

# --- Database (Neon Postgres + pgvector) ---
# Pooled URL, used by the app at runtime
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct URL, used for schema migrations (`npm run db:migrate`, runs before every build)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Auth ---
# Signs login sessions. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- AI answers (optional; search works without it). First match wins: ---
# 1) Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# 2) Any OpenAI-compatible API (e.g. Gemini: https://generativelanguage.googleapis.com/v1beta/openai)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# 3) Neon AI Gateway (needs AI Gateway credits on your Neon account; written by `neon env pull`)
# NEON_AI_GATEWAY_BASE_URL=
# NEON_AI_GATEWAY_TOKEN=

# Embeddings run inside the app (BAAI/bge-small-en-v1.5 via ONNX) — no key needed.
